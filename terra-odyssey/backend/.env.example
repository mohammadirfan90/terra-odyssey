# ───────────────────────────────────────────────────────────────
# Terra Odyssey — Backend Environment Variables (.env)
# ───────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your values.
# This file is git-ignored.

# ── NASA Earthdata (for CMR queries & data download) ──────────
# Create a free account at https://urs.earthdata.nasa.gov/
EARTHDATA_USERNAME=your_earthdata_username
EARTHDATA_PASSWORD=your_earthdata_password

# ── NVIDIA NIM (universal natural-language query) ─────────────
# Create a key at https://build.nvidia.com/ and keep it server-side.
NVIDIA_API_KEY=your_nvidia_api_key
# Optional overrides; defaults shown here.
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# Default model: NVIDIA Nemotron-3 Super (120B MoE / 12B active) — best
# accuracy/speed balance for grounded scientific Q&A. Accepts friendly
# aliases: "super" (default), "ultra" (550B MoE, most accurate, slower),
# "flash" (deepseek-v4.1-flash, fastest, lower accuracy).
NVIDIA_NIM_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_NIM_TIMEOUT_SECONDS=25
# Lower temperature (0.0–1.0) yields more deterministic, factual answers;
# 0.3 is recommended for scientific guidance. Default 0.3.
NVIDIA_NIM_TEMPERATURE=0.3
# Cap on tokens returned per completion. Default 768 — long enough for
# grounded multi-paragraph answers, short enough to stay sub-second.
NVIDIA_NIM_MAX_TOKENS=768

# ── App settings ──────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
